  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=22><b>TENTAMENSINSTRUKTIONER & REGELVERK</b></size>\r\n\r\n\u2022
    Det \xE4r f\xF6rbjudet att anv\xE4nda mobiltelefoner, smartwatch, l\xE4splatta
    eller annan teknisk utrustning under skrivtiden. Dessa ska vara avst\xE4ngda
    och undanstoppade.\r\n\u2022 Tentamen sker under strikt tidspress. Koden ska
    skrivas med exakt syntax (stora/sm\xE5 bokst\xE4ver och tecken r\xE4knas).\r\n\u2022
    CSN-utbetalning baseras direkt p\xE5 ditt betygsf\xF6rs\xF6k.\r\n\r\n<b>BETYGSSKALA
    (A-U):</b>\r\nA = 85-100% (4 000 KR CSN)      D = 55-64% (2 500 KR CSN)\r\nB
    = 75-84%  (3 500 KR CSN)      E = 50-54% (2 000 KR CSN)\r\nC = 65-74%  (3 000
    KR CSN)      U = <50%   (UNDERK\xC4ND - 0 KR)"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
